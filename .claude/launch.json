{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "local",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev-server.js"],
      "port": 3000
    },
    {
      "name": "dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "npx vercel dev --listen %PORT%"
      ],
      "autoPort": true
    }
  ]
}
