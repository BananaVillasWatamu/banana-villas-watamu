# Copy to .env for local `vercel dev`, and add the same values in the
# Vercel project's Environment Variables settings for production.

# Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Supabase project settings -> API -> service_role (secret, server-only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# iCal export URLs from your Airbnb host calendar and Booking.com extranet.
# Optional here: these are meant to be set from the admin dashboard's
# Bookings tab (saved into site_settings) instead. These env vars are only
# used as a fallback if the dashboard fields are empty.
AIRBNB_ICAL_URL=https://www.airbnb.com/calendar/ical/xxxxx.ics
BOOKING_ICAL_URL=https://admin.booking.com/hotel/hoteladmin/ical.html?xxxxx

# Random secret string; also set as the value Vercel Cron sends and that
# /api/admin/* checks for manual "sync now" calls from the admin dashboard.
CRON_SECRET=generate-a-random-string

# NOTE: SUPABASE_URL and SUPABASE_ANON_KEY are also needed by the browser
# (supabaseClient.js) for the public site and the admin dashboard. Since
# this project has no build step, they're hardcoded directly in
# supabaseClient.js rather than read from this file — update both places
# when you rotate the anon key. The anon key is safe to expose publicly;
# it only grants what the RLS policies in supabase/schema.sql allow.
