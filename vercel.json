{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/activities",
      "destination": "/api/activities"
    },
    {
      "source": "/activities/:slug",
      "destination": "/api/activity?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?kind=sitemap"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/seo?kind=llms"
    },
    {
      "source": "/(.*)",
      "destination": "/api/seo?kind=not-found"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-holds",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-ical",
      "schedule": "15 3 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "home.template.html"
    },
    "api/activities.js": {
      "includeFiles": "activities.template.html"
    },
    "api/activity.js": {
      "includeFiles": "activity.template.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co https://banana-villas-watamu.vercel.app; connect-src 'self' https://*.supabase.co; frame-src https://maps.google.com https://www.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
